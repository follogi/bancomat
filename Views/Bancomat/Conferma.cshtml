@model BancomatApp.Models.RisultatoPrelievoViewModel

@{
    ViewData["Title"] = "Bancomat - Conferma Prelievo";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-success">
                <div class="card-header bg-success text-white text-center">
                    <h3>
                        <i class="bi bi-check-circle-fill"></i> PRELIEVO EFFETTUATO
                    </h3>
                </div>
                <div class="card-body p-5 text-center">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">@Model.Messaggio</h4>
                    </div>

                    <div class="my-4 p-4 bg-light rounded">
                        <h5 class="text-muted mb-3">Dettagli prelievo:</h5>
                        <div class="mb-3">
                            <h6 class="text-muted">Importo prelevato:</h6>
                            <h2 class="text-success fw-bold">@Model.ImportoPrelevato.ToString("C")</h2>
                        </div>
                        <hr>
                        <div>
                            <h6 class="text-muted">Nuovo saldo:</h6>
                            <h3 class="text-primary fw-bold">@Model.NuovoSaldo.ToString("C")</h3>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-4" role="alert">
                        <i class="bi bi-cash-stack"></i>
                        <strong>Ritira i contanti dallo sportello</strong>
                    </div>

                    <div class="mt-4">
                        <p class="text-muted">
                            <i class="bi bi-clock-history"></i>
                            Grazie per aver utilizzato il nostro servizio!<br>
                            <small>Tra <span id="countdown">5</span> secondi tornerai alla schermata iniziale...</small>
                        </p>
                    </div>

                    <div class="d-grid mt-3">
                        <a asp-action="Login" class="btn btn-primary">
                            <i class="bi bi-arrow-left-circle"></i> Torna subito alla schermata iniziale
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Countdown e redirect automatico
        let countdown = 5;
        const countdownElement = document.getElementById('countdown');

        const timer = setInterval(function() {
            countdown--;
            countdownElement.textContent = countdown;

            if (countdown <= 0) {
                clearInterval(timer);
                window.location.href = '@Url.Action("Login", "Bancomat")';
            }
        }, 1000);
    </script>
}
