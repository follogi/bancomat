@model BancomatApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Bancomat - Inserimento PIN";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center">
                    <h3>BANCOMAT</h3>
                    <p class="mb-0">Inserisci il tuo codice PIN</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Pin" class="form-label fw-bold">Codice PIN (4 cifre)</label>
                            <input asp-for="Pin" type="password" class="form-control form-control-lg text-center"
                                   maxlength="4" placeholder="****" autofocus />
                            <span asp-validation-for="Pin" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Conferma
                            </button>
                        </div>
                    </form>

                    <div class="mt-4 text-center text-muted">
                        <small>
                            <strong>PIN di test:</strong><br>
                            1234 | 5678
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
